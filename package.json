{
  "name": "personal-finance-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "format-and-fix": "biome check --write",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "test:coverage:open": "vitest run --coverage && node -e \"require('node:child_process').exec(process.platform==='win32'?'start coverage/index.html':process.platform==='darwin'?'open coverage/index.html':'xdg-open coverage/index.html')\"",
    "build:instant-nav": "next build",
    "test:instant-nav": "playwright test",
    "prisma:generate": "prisma generate --schema=src/back-end/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/back-end/prisma/schema.prisma",
    "prisma:push-force": "prisma db push --schema=src/back-end/prisma/schema.prisma --force-reset",
    "prisma:migrate": "prisma migrate dev --schema=src/back-end/prisma/schema.prisma",
    "recreate-db": "npm run prisma:generate && npm run prisma:push",
    "postinstall": "npm run recreate-db"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "animate-css-grid": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.15.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-use": "^17.6.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@next/playwright": "^16.4.6",
    "@playwright/test": "^1.65.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
