{
  "name": "personal-finance-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "format-and-fix": "biome check --write",
    "test": "vitest",
    "test:run": "vitest run",
    "prisma:generate": "prisma generate --schema=src/back-end/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/back-end/prisma/schema.prisma",
    "prisma:push-force": "prisma db push --schema=src/back-end/prisma/schema.prisma --force-reset",
    "prisma:migrate": "prisma migrate dev --schema=src/back-end/prisma/schema.prisma",
    "recreate-db": "npm run prisma:generate && npm run prisma:push",
    "postinstall": "npm run recreate-db"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "animate-css-grid": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.31",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-use": "^17.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@prisma/client": "^6.15.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "jsdom": "^29.1.1",
    "prisma": "^6.15.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
